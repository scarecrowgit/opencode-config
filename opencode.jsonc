{
  "$schema": "https://opencode.ai/config.json",
  "model": "9router/cc/claude-opus-5-5",
  "small_model": "9router/cx/gpt-5.6-terra",
  "provider": {
    "lmstudio-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local worker)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "qwen3.6-35b-a3b-uncensored-hauhaucs-aggressive": {
          "name": "Qwen 3.6 35B (worker)"
        }
      }
    }
  },
  // Imported from Hermes (~/.hermes/config.yaml mcp_servers).
  // timeout = 120s to match Hermes' tool-call default (opencode default is 5s).
  // Hermes connect_timeout has no opencode equivalent and is dropped.
  "mcp": {
    "9router": {
      "type": "local",
      "command": ["/mnt/storage/work/claude/bin/ninerouter"],
      "enabled": true,
      "timeout": 120000
    },
    "grafana": {
      // run.sh reads the token from ~/.config/grafana-mcp/token
      "type": "local",
      "command": ["/home/vxwwx/.config/grafana-mcp/run.sh"],
      "enabled": true,
      "timeout": 120000
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true,
      "timeout": 120000
    },
    "cloudflare-api": {
      // OAuth: run `opencode mcp auth cloudflare-api` once
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true,
      "timeout": 120000
    }
  }
}
